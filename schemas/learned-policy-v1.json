{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "learned_policy"
      ]
    },
    "architecture": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 4,
      "maxItems": 4
    },
    "feature_schema": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 30,
          "maxItems": 30
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "names",
        "normalization"
      ],
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "bias": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "weight",
          "bias"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "metadata": {
      "type": "object"
    },
    "model_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "architecture",
    "feature_schema",
    "layers",
    "metadata",
    "model_hash"
  ],
  "additionalProperties": false
}
