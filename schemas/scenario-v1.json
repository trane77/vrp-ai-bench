{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRP AI scenario v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "synthetic"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "path_policy": {
          "enum": [
            "fixed_directed_paths",
            "osrm_alternatives_evaluated"
          ]
        }
      },
      "required": [
        "kind",
        "description",
        "dataset_id",
        "dataset_version",
        "path_policy"
      ],
      "additionalProperties": false
    },
    "reference_instant": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "start_s": {
      "type": "integer",
      "minimum": 0
    },
    "depot_id": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true
    },
    "capacity": {
      "type": "object",
      "properties": {
        "mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume_m3": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "mass_kg",
        "volume_m3"
      ],
      "additionalProperties": false
    },
    "duration_cap_s": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "window_open_s": {
            "type": "integer",
            "minimum": 0
          },
          "window_close_s": {
            "type": "integer",
            "minimum": 0
          },
          "packages": {
            "type": "integer",
            "minimum": 0
          },
          "mass_kg": {
            "type": "number",
            "minimum": 0
          },
          "volume_m3": {
            "type": "number",
            "minimum": 0
          },
          "delivery_mass_kg": {
            "type": "number",
            "minimum": 0
          },
          "delivery_volume_m3": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "window_open_s",
          "window_close_s",
          "packages",
          "mass_kg",
          "volume_m3"
        ],
        "additionalProperties": false
      }
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reachable": {
            "type": "boolean"
          },
          "travel_s": {
            "type": "integer",
            "minimum": 0
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "distance_m": {
                  "type": "number",
                  "minimum": 0
                },
                "driving_category": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "distance_m",
                "driving_category"
              ],
              "additionalProperties": false
            }
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "travel_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "distance_m": {
                  "type": "number",
                  "minimum": 0
                },
                "segments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "distance_m": {
                        "type": "number",
                        "minimum": 0
                      },
                      "driving_category": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "distance_m",
                      "driving_category"
                    ],
                    "additionalProperties": false
                  }
                },
                "geometry": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "raw_duration_s": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "travel_s",
                "distance_m",
                "segments"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "source",
          "target",
          "reachable",
          "travel_s",
          "segments"
        ],
        "additionalProperties": false
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "constant",
            "packages"
          ]
        },
        "constant_s": {
          "type": "integer",
          "minimum": 0
        },
        "fixed_s": {
          "type": "integer",
          "minimum": 0
        },
        "per_package_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "constant_s",
        "fixed_s",
        "per_package_s"
      ],
      "additionalProperties": false
    },
    "fuel_model": {
      "type": "object",
      "properties": {
        "version": {
          "enum": [
            "linear-load-v1"
          ]
        },
        "kind": {
          "enum": [
            "load_dependent",
            "distance_equivalent_control"
          ]
        },
        "calibration": {
          "enum": [
            "uncalibrated",
            "microsim_calibrated"
          ]
        },
        "label": {
          "enum": [
            "experimental estimate",
            "distance-equivalent control estimate",
            "microsim-calibrated estimate"
          ]
        },
        "categories": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "base_l_per_km": {
                "type": "number",
                "minimum": 0
              },
              "load_l_per_km_kg": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "base_l_per_km",
              "load_l_per_km_kg"
            ],
            "additionalProperties": false
          }
        },
        "idle_policy": {
          "enum": [
            "off",
            "waiting_and_service"
          ]
        },
        "idle_l_per_s": {
          "type": "number",
          "minimum": 0
        },
        "calibration_metadata": {
          "type": "object",
          "properties": {
            "simulator": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "curb_mass_kg": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rmse_l": {
              "type": "number",
              "minimum": 0
            },
            "mae_l": {
              "type": "number",
              "minimum": 0
            },
            "relative_bias_pct": {
              "type": "number"
            },
            "validity_bounds": {
              "type": "object",
              "properties": {
                "mass_kg_min": {
                  "type": "number",
                  "minimum": 0
                },
                "mass_kg_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "speed_kmh_min": {
                  "type": "number",
                  "minimum": 0
                },
                "speed_kmh_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "mass_kg_min",
                "mass_kg_max",
                "speed_kmh_min",
                "speed_kmh_max"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "simulator",
            "seed",
            "curb_mass_kg",
            "rmse_l",
            "mae_l",
            "relative_bias_pct",
            "validity_bounds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "kind",
        "calibration",
        "label",
        "categories",
        "idle_policy",
        "idle_l_per_s"
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "properties": {
        "time_weight": {
          "type": "number",
          "minimum": 0
        },
        "fuel_weight": {
          "type": "number",
          "minimum": 0
        },
        "time_scale_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fuel_scale_l": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "time_weight",
        "fuel_weight",
        "time_scale_s",
        "fuel_scale_l"
      ],
      "additionalProperties": false
    },
    "path_optimization": {
      "type": "boolean"
    },
    "vehicle_capacities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mass_kg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "volume_m3": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "mass_kg",
          "volume_m3"
        ],
        "additionalProperties": false
      }
    },
    "driver_break": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "threshold_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "threshold_s",
        "duration_s"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "provenance",
    "reference_instant",
    "timezone",
    "start_s",
    "depot_id",
    "vehicle_ids",
    "capacity",
    "duration_cap_s",
    "stops",
    "legs",
    "service",
    "fuel_model",
    "objective"
  ],
  "additionalProperties": false
}
