{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRP AI solution v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vehicle_id": {
            "type": "string",
            "minLength": 1
          },
          "stop_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "path_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "vehicle_id",
          "stop_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "routes"
  ],
  "additionalProperties": false
}
