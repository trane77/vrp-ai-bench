{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "enum": [
        "experiment_report"
      ]
    },
    "manifest_hash": {
      "type": "string",
      "minLength": 1
    },
    "completed": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "const": 102
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fronts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "manifest_hash",
    "completed",
    "total",
    "rows",
    "fronts"
  ],
  "additionalProperties": true
}
